{
  "info": {
    "description": "API du backend Afribox (SmartParcel). Tous les points d'accès acceptent du JSON en POST (sauf indication contraire). L'authentification se fait via un `apikey` dans le corps de la requête : une clé d'application, une clé publique d'entreprise ou une clé secrète d'entreprise. Le statut HTTP est toujours 200 ; le résultat est indiqué dans le corps via `statuscode` (`00` = succès) et `statusmessage`."
  },
  "tags": {
    "core": "Données de référence publiques : États, villes, casiers, tailles, frais, coursiers, zones de livraison.",
    "customer": "Comptes clients : inscription/connexion/OTP, profil, cartes enregistrées, colis, assistance.",
    "business": "Comptes entreprises/partenaires : tableau de bord, casiers, colis, portefeuille, historique des transactions.",
    "kiosk": "Opérations du casier/appareil : configuration, ping, dépôt/retrait de colis, réservation/vérification appless, instantanés.",
    "pay": "Paiements : recherche/succès du paiement d'un colis, et les points Paystack initialize/verify/status/return/webhook.",
    "parcel": "Preuves de livraison (instantanés) : liste, récupération, image.",
    "admin": "Opérations d'administration : liste des entreprises et transactions de portefeuille."
  },
  "templates": {
    "operationDescription": "Authentification : **{auth}** (voir le guide d'authentification). La réponse est en HTTP 200 ; le résultat se trouve dans le champ `statuscode` du corps.",
    "response200": "Enveloppe de résultat (statuscode/statusmessage). Un `statuscode` différent de `00` indique une erreur."
  },
  "authLabels": {
    "app_key": "clé d'application",
    "business_public": "clé publique d'entreprise",
    "business_secret": "clé secrète d'entreprise",
    "paystack_dual": "clé secrète d'entreprise ou clé d'application",
    "none": "aucune (webhook signé)"
  },
