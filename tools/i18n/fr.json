    "get_pay_return": {
      "summary": "Page de retour de paiement",
      "description": "Page de retour hébergée. Vérifie le paiement, exécute le traitement, puis redirige vers `metadata.returnurl` si présent. Renvoie une page HTML (pas de JSON). Paramètres : `reference` (ou `trxref`)."
    },
    "post_pay_initialize": {
      "summary": "Initialiser un paiement Paystack",
      "description": "Crée une transaction Paystack. L'authentification accepte **soit** une clé secrète d'entreprise (B2B), **soit** une clé d'application avec un `customerid` facultatif (B2C). Le `amount` est en unité majeure (XOF). Utilisez `metadata.parcelreference` pour marquer un colis payé, ou `metadata.fulfil=\"wallet\"` pour créditer le portefeuille d'une entreprise. La réponse contient `authorizationurl` (paiement hébergé) et `accesscode` (popup Paystack)."
    },
    "post_pay_verify": {
      "summary": "Vérifier un paiement Paystack",
      "description": "Vérifie un paiement par `reference`, l'enregistre et exécute le traitement (colis payé / crédit portefeuille) de façon idempotente. Un succès déjà enregistré n'est jamais rétrogradé. Renvoie le `collectcode` du colis pour les paiements de colis."
    },
    "post_pay_status": {
      "summary": "Statut du paiement par référence",
      "description": "Renvoie le statut enregistré pour une référence, en confirmant auprès de Paystack si nécessaire. Destiné au sondage par l'application casier et le bot WhatsApp."
    },
    "post_pay_search": {
      "summary": "Rechercher un colis à payer"
    },
    "post_pay_success": {
      "summary": "Confirmer le paiement d'un colis"
    },
    "post_pay_webhook_paystack": {
      "summary": "Webhook Paystack",
      "description": "Webhook serveur à serveur. Paystack signe le corps brut en HMAC-SHA512 avec la clé secrète ; la signature est envoyée dans l'en-tête `x-paystack-signature` et validée. Gère `charge.success` et `charge.failed`. Renvoie HTTP 200 en cas de succès, 403 si la signature est invalide. Non appelé par les clients."
    }
  },
  "schemas": {
    "PaystackInitializeResponse": {
      "description": "Résultat de l'initialisation Paystack."
    },
    "PaystackVerifyResponse": {
      "description": "Détails de la transaction vérifiée, y compris le code de retrait du colis le cas échéant."
    }
  }
