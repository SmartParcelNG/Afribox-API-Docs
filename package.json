{
  "name": "afribox-api-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "gen-api-docs": "docusaurus gen-api-docs afriboxread --plugin-id afribox-read && docusaurus gen-api-docs afriboxwrite --plugin-id afribox-write && docusaurus gen-api-docs afriboxreadfr --plugin-id afribox-read-fr && docusaurus gen-api-docs afriboxwritefr --plugin-id afribox-write-fr",
    "clean-api-docs": "docusaurus clean-api-docs afriboxread --plugin-id afribox-read && docusaurus clean-api-docs afriboxwrite --plugin-id afribox-write && docusaurus clean-api-docs afriboxreadfr --plugin-id afribox-read-fr && docusaurus clean-api-docs afriboxwritefr --plugin-id afribox-write-fr",
    "lint:spec": "redocly lint openapi/openapi.json --config .redocly.yaml",
    "generate": "python3 tools/generate_openapi.py"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "latest",
    "docusaurus-plugin-sass": "^0.2.7",
    "docusaurus-theme-openapi-docs": "latest",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@redocly/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
